+#ifdef CONFIG_32BIT
+/*
+ * Compas diagnostic: after the Code: line of a kernel-mode fault, read the
+ * same words again through the cached KSEG0 address and through the uncached
+ * KSEG1 alias of the same physical address.
+ *
+ * KSEG0 shows what a data load sees now: the D-cache line, or memory through
+ * the cache hierarchy on a miss. KSEG1 shows the words in DRAM, bypassing the
+ * caches. Neither shows the I-cache line the CPU fetched, and both are read
+ * after the fault, so matching words prove only that the bytes were correct
+ * at the time of this read.
+ *
+ * Only aligned core kernel text in the unmapped KSEG0/KSEG1 segments is
+ * read, so no TLB or address error is expected. Faulty memory can still
+ * raise a bus error, so every load goes through get_dbe(): do_be() resolves
+ * it from __dbe_table (it does not consult __ex_table, which __get_user
+ * uses), and the first failed read stops the comparison. A cache error
+ * exception or an imprecise bus error cannot be recovered this way.
+ * Nothing is written, flushed or invalidated.
+ */
+static void show_code_aliases(struct pt_regs *regs)
+{
+	unsigned long epc = regs->cp0_epc;
+	unsigned long first = epc - 3 * sizeof(u32);
+	unsigned long last = epc + 5 * sizeof(u32);
+	unsigned long addr;
+	u32 insn;
+
+	if (IS_ENABLED(CONFIG_EVA) || user_mode(regs) || (epc & 3))
+		return;
+	if (first > epc || last < epc)
+		return;
+	if (first < (unsigned long)_stext ||
+	    last + sizeof(u32) > (unsigned long)_etext)
+		return;
+	if ((first & 0xe0000000UL) != CKSEG0 ||
+	    (last & 0xe0000000UL) != CKSEG0)
+		return;
+
+	printk("\nCode KSEG0 cached:");
+	for (addr = first; addr <= last; addr += sizeof(u32)) {
+		if (get_dbe(insn, (u32 *)addr)) {
+			printk(" (read failed; alias comparison stopped)");
+			return;
+		}
+		printk("%c%08x%c", addr == epc ? '<' : ' ', insn,
+		       addr == epc ? '>' : ' ');
+	}
+	printk("\nCode KSEG1 uncached phys %08lx:",
+	       (unsigned long)CPHYSADDR(epc));
+	for (addr = first; addr <= last; addr += sizeof(u32)) {
+		if (get_dbe(insn, (u32 *)CKSEG1ADDR(addr))) {
+			printk(" (read failed; alias comparison stopped)");
+			return;
+		}
+		printk("%c%08x%c", addr == epc ? '<' : ' ', insn,
+		       addr == epc ? '>' : ' ');
+	}
+}
+#else
+static inline void show_code_aliases(struct pt_regs *regs)
+{
+}
+#endif
