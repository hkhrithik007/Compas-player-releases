+#if defined(CONFIG_32BIT) && !defined(CONFIG_EVA)
+/* Opt-in boot test; never probe a missing physical device to induce a DBE. */
+static bool compas_oops_selftest __initdata;
+
+static int __init compas_oops_selftest_setup(char *value)
+{
+	if (strcmp(value, "1"))
+		return 0;
+	compas_oops_selftest = true;
+	return 1;
+}
+__setup("compas_oops_selftest=", compas_oops_selftest_setup);
+
+/* Keep the worker and its data outside init sections: it runs asynchronously. */
+static int compas_oops_selftest_run(void *unused)
+{
+	unsigned long words[2] = { 0x89abcdef, 0x12345678 };
+	unsigned long __user *p = (unsigned long __user *)words;
+	u16 half = 0x89ab;
+	unsigned long word = 0;
+	unsigned int insn = 0;
+	struct pt_regs regs = { 0 };
+	int failed = 0;
+	int err;
+
+	if (panic_on_oops) {
+		printk(KERN_INFO "Compas Oops selftest: SKIP (panic_on_oops enabled)\n");
+		return 0;
+	}
+
+	/* Exercise widths, unsigned halfword conversion and pointer evaluation. */
+	if (get_diag_value(word, p++) || word != words[0] ||
+	    p != (unsigned long __user *)&words[1])
+		failed++;
+	if (get_diag_value(insn, (u16 __user *)&half) || insn != half)
+		failed++;
+
+	/* This kernel thread has no user mm.  Disable page faults to test
+	 * __ex_table recovery for NULL without resolving a user mapping.
+	 */
+	word = ~0UL;
+	pagefault_disable();
+	err = get_diag_value(word, (unsigned long __user *)0);
+	pagefault_enable();
+	if (err != -EFAULT || word != 0)
+		failed++;
+
+	/* Only known core text: exercise the existing formatters and aliases. */
+	regs.cp0_epc = (unsigned long)_stext + 3 * sizeof(u32);
+	regs.cp0_status = KSU_KERNEL;
+	printk(KERN_INFO "Compas Oops selftest: %s (word, halfword, address fixup); precise DBE recovery NOT injected\n",
+	       failed ? "FAIL" : "PASS");
+	show_code((unsigned int __user *)regs.cp0_epc);
+	show_code((unsigned int __user *)(regs.cp0_epc | 1));
+	show_code_aliases(&regs);
+	printk("\n");
+	return 0;
+}
+static int __init compas_oops_selftest_init(void)
+{
+	struct task_struct *task;
+
+	if (!compas_oops_selftest)
+		return 0;
+	/* Never let a failed test kill PID 1 or make init wait for the worker. */
+	task = kthread_run(compas_oops_selftest_run, NULL, "compas-oops-test");
+	if (IS_ERR(task))
+		printk(KERN_WARNING "Compas Oops selftest: SKIP (worker start failed: %ld)\n",
+		       PTR_ERR(task));
+	return 0;
+}
+late_initcall(compas_oops_selftest_init);
+#endif
 
