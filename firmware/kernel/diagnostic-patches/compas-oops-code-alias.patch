+/*
+ * R1 diagnostic reads need both fixup tables: __ex_table preserves the
+ * normal __get_user address/TLB-fault handling, while do_be() consults
+ * __dbe_table for a precise kernel-mode data bus error.  Using get_dbe()
+ * alone here would lose the former for user or mapped kernel addresses.
+ *
+ * This is __get_data_asm's load and fixup, with the same site registered
+ * in the bus-error table too.  Keep the original widths, signed-load casts,
+ * pointer evaluation and access policy; these callers already use
+ * __get_user, not get_user.  No new addresses are read or cache maintenance
+ * performed.  Other architectures and EVA retain their original accessors.
+ * This does not protect printk, the general unwinder, cache-error exceptions
+ * or imprecise bus errors.
+ */
+#if defined(CONFIG_32BIT) && !defined(CONFIG_EVA)
+#define __get_diag_asm(val, insn, addr)                                   \
+{                                                                       \
+	long __diag_tmp;                                                \
+	__asm__ __volatile__(                                           \
+	"1: " insn("%1", "%3") "\n"                                  \
+	"2:\n\t.insn\n\t.section .fixup,\"ax\"\n"                       \
+	"3: li %0, %4\n\tmove %1, $0\n\tj 2b\n\t.previous\n"            \
+	"\t.section __ex_table,\"a\"\n\t"                              \
+	__UA_ADDR " 1b, 3b\n\t.previous\n"                              \
+	"\t.section __dbe_table,\"a\"\n\t"                             \
+	__UA_ADDR " 1b, 3b\n\t.previous\n"                              \
+	: "=r" (__diag_err), "=r" (__diag_tmp)                           \
+	: "0" (0), "o" (__m(addr)), "i" (-EFAULT));                      \
+	(val) = (__typeof__(*(addr))) __diag_tmp;                        \
+}
+
+#define get_diag_value(x, ptr)                                          \
+({                                                                      \
+	int __diag_err;                                                \
+	const __typeof__(*(ptr)) __user *__diag_ptr = (ptr);             \
+	__chk_user_ptr(__diag_ptr);                                     \
+	switch (sizeof(*__diag_ptr)) {                                  \
+	case 2: __get_diag_asm(x, user_lh, __diag_ptr); break;            \
+	case 4: __get_diag_asm(x, user_lw, __diag_ptr); break;            \
+	default: __diag_err = __get_user(x, __diag_ptr); break;          \
+	}                                                              \
+	__diag_err;                                                    \
+})
+#else
+#define get_diag_value(x, ptr) __get_user(x, ptr)
+#endif
+
