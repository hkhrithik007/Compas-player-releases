prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ssc
Description: bounded Samsung SSC encoder wrapper (stereo 16-bit, 44.1/48 kHz)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lssc -pthread
Cflags: -I${includedir}
